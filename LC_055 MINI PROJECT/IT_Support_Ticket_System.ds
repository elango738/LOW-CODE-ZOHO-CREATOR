		workflow
		{
		form
		{
			auto_assign_critical_tickets as "Auto-assign Critical Tickets"
			{
				type =  form
				form = tickets

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch all IT agents who are available
										itAgents = support_agents[department == "IT" && status == "Available"];
										// Check if there are any available IT agents
										if(itAgents.count() > 0)
										{
											// Get the first available IT agent
											assignedAgent = itAgents;
											// Update the ticket with the assigned agent
											input.assigned_agent = assignedAgent.ID;
											// Update the ticket status to In Progress
											input.status = "In Progress";
											// Log the assignment
											info "Critical ticket assigned to IT agent: " + assignedAgent.agent_name;
										}
										else
										{
											// No available IT agents - assign to admin or log for manual assignment
											if(zoho.loginuserid == zoho.adminuserid)
											{
												info "No available IT agents found. Ticket remains unassigned for manual assignment.";
											}
											else
											{
												// Notify admin about unassigned critical ticket
												info "Critical ticket could not be auto-assigned. No available IT agents.";
											}
										}
						)
					}
				}

			}
			block_low_priority_submission as "Block Low Priority Submission"
			{
				type =  form
				form = tickets

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if priority is Low
										if(input.priority.equalsIgnoreCase("Low"))
										{
											// Check if justification field is blank or null
											if(input.description.isBlank() || input.description.isNull())
											{
												// Display alert message
												alert(priority,"Please provide justification for Low priority ticket");
												// Cancel the submission
												cancel submit;
											}
										}
						)
					}
				}

			}
			notify_agent_on_assignment as "Notify Agent on Assignment"
			{
				type =  form
				form = tickets

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the assigned agent record from support_agents form
										assignedAgentRecord = support_agents[ID == input.assigned_agent];
										// Check if the assigned agent record exists and has a valid email
										if(assignedAgentRecord.email.isNull() == false)
										{
											// Send email notification to the assigned agent
											sendmail
											[
												from :zoho.loginuserid
												to :assignedAgentRecord.email
												subject :"New Ticket Assigned: " + input.ticket_title
												message :"You have been assigned a new support ticket.\n\nTicket Title: " + input.ticket_title + "\nPriority: " + input.priority + "\nDescription: " + input.description
											]
										}
						)
					}
				}

			}
		}






	}
	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"adiministrator"
			{
				name = "adiministrator"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "adiministrator Profile\n"
				ModulePermissions
				{
					ticket_comments
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							ticket_comments_Report={"View","Edit","Delete"}
						}
					}
					tickets
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							tickets_Report={"View","Edit","Delete"}
							tickets_by_priority={"View","Edit","Delete"}
						}
					}
					categories
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab,read_comm,write_comm,create_new_report 
						allFieldsVisible= true 
						ReportPermissions
						{
							categories_Report={"View","Edit","Delete"}
						}
					}
					support_agents
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab,read_comm,write_comm,create_new_report 
						allFieldsVisible= true 
						ReportPermissions
						{
							support_agents_Report={"View","Edit","Delete"}
							support_agents_by_department={"View","Edit","Delete"}
						}
					}
					users
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							users_by_department={"View","Edit","Delete"}
							users_Report={"View","Edit","Delete"}
						}
					}
					DashBoard
					{
						enabled = tab
					}
				}
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}


