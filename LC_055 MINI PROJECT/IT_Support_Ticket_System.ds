 application "IT Support Ticket System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form categories
		{
			displayname = "Categories"
			success message = "Categories Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			category_name
			(
    			type = text
				displayname = "Category Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = radiobuttons
				displayname = "Status"
				values = {"Active","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form support_agents
		{
			displayname = "Support Agents"
			success message = "Support Agents Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			agent_name
			(
    			type = name
				displayname = "Agent Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist
				displayname = "Department"
				values = {"Sales","Finance","HR","IT","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			expertise
			(
    			type = text
				displayname = "Expertise"
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Busy","Inactive","Available"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form ticket_comments
		{
			displayname = "Ticket Comments"
			success message = "Ticket Comments Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			ticket_1
			(
				type = list	
				displayname = "Ticket"
				values  = tickets.ID
    			displayformat = [ticket_title]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			comment
			(
    			type = textarea
				displayname = "Comment"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			commented_by
			(
				type = list	
				displayname = "Commented By"
				values  = users.ID
    			displayformat = [full_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			comment_date
			(
    			type = datetime
				displayname = "Comment Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form tickets
		{
			displayname = "Tickets"
			success message = "Tickets Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			ticket_title
			(
    			type = text
				displayname = "Ticket Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			category
			(
				type = list	
				displayname = "Category"
				values  = categories.ID
    			displayformat = [category_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			priority
			(
				type = picklist
				displayname = "Priority"
				values = {"High","Low","Medium","Critical"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Closed","In Progress","Resolved","Open"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_agent
			(
				type = list	
				displayname = "Assigned Agent"
				values  = support_agents.ID
    			displayformat = [agent_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_by
			(
				type = list	
				displayname = "Created By"
				values  = users.ID
    			displayformat = [full_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = datetime
				displayname = "Created Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			resolved_date
			(
    			type = datetime
				displayname = "Resolved Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			attachment
			(
    			type = url
				displayname = "Attachment"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form users
		{
			displayname = "Users"
			success message = "Users Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			full_name
			(
    			type = name
				displayname = "Full Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist
				displayname = "Department"
				values = {"Sales","Finance","HR","IT","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			user_role
			(
				type = picklist
				displayname = "User Role"
				values = {"Agent","User","Admin"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = radiobuttons
				displayname = "Status"
				values = {"Active","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list tickets_Report
		{
			displayName = "All Tickets"
			show all rows from tickets    
			(
				ticket_title as "Ticket Title"
				description as "Description"
				category as "Category"
				priority as "Priority"
				status as "Status"
				assigned_agent as "Assigned Agent"
				created_by as "Created By"
				created_date as "Created Date"
				resolved_date as "Resolved Date"
				attachment as "Attachment"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (priority == "High")
				fields = [priority]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (priority == "Low")
				fields = [priority]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban tickets_by_priority
		{
			displayName = "Priorities"
			show all rows from tickets    
			(
				ticket_title as "Ticket Title"
				description as "Description"
				category as "Category"
				priority as "Priority"
				status as "Status"
				assigned_agent as "Assigned Agent"
				created_by as "Created By"
				created_date as "Created Date"
				resolved_date as "Resolved Date"
				attachment as "Attachment"
			)
			options
			(
	 			display field = priority
	 		)
		}
		list ticket_comments_Report
		{
			displayName = "All Ticket Comments"
			show all rows from ticket_comments    
			(
				ticket_1 as "Ticket"
				comment as "Comment"
				commented_by as "Commented By"
				comment_date as "Comment Date"
			)
		}
		list categories_Report
		{
			displayName = "All Categories"
			show all rows from categories    
			(
				category_name as "Category Name"
				description as "Description"
				status as "Status"
			)
		}
		list support_agents_Report
		{
			displayName = "All Support Agents"
			show all rows from support_agents    
			(
				agent_name  as "Agent Name"
				email as "Email"
				phone as "Phone Number"
				department as "Department"
				expertise as "Expertise"
				status as "Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (department == "IT")
				fields = [department]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (department == "Other")
				fields = [department]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (department == "Sales")
				fields = [department]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban support_agents_by_department
		{
			displayName = "Departments"
			show all rows from support_agents    
			(
				agent_name  as "Agent Name"
				email as "Email"
				phone as "Phone Number"
				department as "Department"
				expertise as "Expertise"
				status as "Status"
			)
			options
			(
	 			display field = department
	 		)
		}
		list users_Report
		{
			displayName = "All Users"
			show all rows from users    
			(
				full_name  as "Full Name"
				email as "Email"
				phone as "Phone Number"
				department as "Department"
				user_role as "User Role"
				status as "Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (department == "Finance")
				fields = [department]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (department == "HR")
				fields = [department]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban users_by_department
		{
			displayName = "Departments"
			show all rows from users    
			(
				full_name  as "Full Name"
				email as "Email"
				phone as "Phone Number"
				department as "Department"
				user_role as "User Role"
				status as "Status"
			)
			options
			(
	 			display field = department
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
