		workflow
		{
		form
		{
			auto_set_application_status as "Auto-Set Application Status"
			{
				type =  form
				form = loan_application

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Set the application_status field to Document Verification upon submission
										input.application_status = "Document Verification";
										// Log the update for debugging purposes
										info "Application status updated to Document Verification by user: " + zoho.loginuser;
						)
					}
				}

			}
			validate_income_requirement as "Validate Income Requirement"
			{
				type =  form
				form = loan_application

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate if monthly income meets minimum requirement
										if(input.monthly_income.isNull())
										{
											alert(monthly_income,"Please enter your monthly income");
											cancel submit;
										}
										// Define minimum income requirement (example: 20000)
										minimumIncome = 20000;
										// Check if income is below minimum
										if(input.monthly_income < minimumIncome)
										{
											alert(monthly_income,"Monthly income must be at least " + minimumIncome.toString());
											cancel submit;
										}
						)
					}
				}

			}
		}

		schedule
		{
			send_document_reminder_email as "Send Document Reminder Email"
			{
				type =  schedule
				form = document_reminder_log
					status = inactive
				start = reminder_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Check if applicant email is available
										if(input.recipient_email.isNull())
										{
											info "No recipient email found in document_reminder_log record";
										}
										else
										{
											// Fetch the loan application record using the multi_select_lookup field
											applicantRecords = loan_application[ID == input.applicant.ID];
											// Check if applicant record exists
											if(applicantRecords.count() > 0)
											{
												// Extract applicant details from the loan application
												applicantName = applicantRecords.applicant_name.first_name.concat(" ").concat(applicantRecords.applicant_name.last_name);
												applicantEmail = applicantRecords.email_address;
												applicationId = applicantRecords.application_id;
												// Get the reminder type
												reminderType = input.reminder_type;
												// Construct email subject
												emailSubject = "Reminder: Missing Documents for Application " + applicationId;
												// Construct email body
												emailBody = "<p>Dear " + applicantName + ",</p>";
												emailBody = emailBody.concat("<p>This is a reminder that the following document is still missing for your loan application:</p>");
												emailBody = emailBody.concat("<p><strong>Document Type:</strong> " + reminderType + "</p>");
												emailBody = emailBody.concat("<p><strong>Application ID:</strong> " + applicationId + "</p>");
												emailBody = emailBody.concat("<p>Please submit the required document at your earliest convenience to avoid any delays in processing your application.</p>");
												emailBody = emailBody.concat("<p>Thank you for your cooperation.</p>");
												emailBody = emailBody.concat("<p>Best regards,<br>Loan Application Team</p>");
												// Send the email
												sendmail
												[
													from :zoho.loginuserid
													to :applicantEmail
													subject :emailSubject
													message :emailBody
													content type :HTML
												]
												// Update the reminder status to Sent
												input.reminder_status = "Sent";
												input.email_sent = true;
											}
											else
											{
												info "Applicant record not found for ID: " + input.applicant.ID;
											}
										}
					)
					}
				}
			}
			monthly_target_achievement_report as "Monthly Target Achievement Report"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all disbursal target records for the current month
										targetRecords = disbursal_target[target_month == zoho.currentdate];
										// Initialize variables for summary
										summaryText = "";
										// Iterate through each target record to build summary
										for each  target in targetRecords
										{
											// Calculate achievement percentage
											if(target.target_amount != null && target.target_amount > 0)
											{
												achievementPercentage = target.achieved_amount / target.target_amount * 100;
											}
											else
											{
												achievementPercentage = 0;
											}
											// Format achievement percentage
											if(achievementPercentage < 10)
											{
												formattedPercentage = "0" + achievementPercentage.toString();
											}
											else
											{
												formattedPercentage = achievementPercentage.toString();
											}
											// Build summary text for this record
											summaryText = summaryText.concat("Branch: ").concat(target.branch_name).concat(" | Target: ").concat(target.target_amount.toString()).concat(" | Achieved: ").concat(target.achieved_amount.toString()).concat(" | Achievement: ").concat(formattedPercentage).concat("%\n");
										}
										// Send email to admin user with summary
										if(summaryText != "")
										{
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.loginuserid
												subject :"Monthly Target Achievement Summary"
												message :"Dear Team,\n\nHere is the monthly target achievement summary:\n\n".concat(summaryText)
											]
										}
					)
					}
				}
			}
		}




	}
