	reports
	{
		list document_reminder_log_Report
		{
			displayName = "Document Reminder Log Report"
			show all rows from document_reminder_log    
			(
				reminder_id as "Reminder Id"
				applicant as "Applicant"
				reminder_date as "Reminder Date"
				reminder_type as "Reminder Type"
				email_sent as "Email Sent"
				reminder_status as "Reminder Status"
				recipient_email as "Recipient Email"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (reminder_type == "General")
				fields = [reminder_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (reminder_type == "Income Proof")
				fields = [reminder_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (reminder_type == "KYC")
				fields = [reminder_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban document_reminder_log_by_reminder_type
		{
			displayName = "Reminder Types"
			show all rows from document_reminder_log    
			(
				reminder_id as "Reminder Id"
				applicant as "Applicant"
				reminder_date as "Reminder Date"
				reminder_type as "Reminder Type"
				email_sent as "Email Sent"
				reminder_status as "Reminder Status"
				recipient_email as "Recipient Email"
			)
			options
			(
	 			display field = reminder_type
	 		)
		}
		list loan_application_Report
		{
			displayName = "All Loan Applications"
			show all rows from loan_application    
			(
				application_id as "Application Id"
				applicant_name  as "Applicant Name"
				contact_number as "Contact Number"
				email_address as "Email Address"
				loan_type as "Loan Type"
				requested_amount as "Requested Amount"
				(
					display = total,average,min,max	
				)
				monthly_income as "Monthly Income"
				(
					display = total,average,min,max	
				)
				servicing_branch as "Servicing Branch"
				application_status as "Application Status"
				document_verification_status as "Document Verification Status"
				submission_date as "Submission Date"
				applicant_address  as "Applicant Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (loan_type == "Auto")
				fields = [loan_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (loan_type == "Business")
				fields = [loan_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (loan_type == "Education")
				fields = [loan_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (loan_type == "Personal")
				fields = [loan_type]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban loan_application_by_application_status
		{
			displayName = "Application Statuses"
			show all rows from loan_application    
			(
				application_id as "Application Id"
				applicant_name  as "Applicant Name"
				contact_number as "Contact Number"
				email_address as "Email Address"
				loan_type as "Loan Type"
				requested_amount as "Requested Amount"
				(
					display = total,average,min,max	
				)
				monthly_income as "Monthly Income"
				(
					display = total,average,min,max	
				)
				servicing_branch as "Servicing Branch"
				application_status as "Application Status"
				document_verification_status as "Document Verification Status"
				submission_date as "Submission Date"
				applicant_address  as "Applicant Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
			)
			options
			(
	 			display field = application_status
	 		)
		}
