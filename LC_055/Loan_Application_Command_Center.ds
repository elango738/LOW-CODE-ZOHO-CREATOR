	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			branch_phone
			(
    			type = phonenumber
				displayname = "Branch Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			branch_email
			(
    			type = email
				displayname = "Branch Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			active_status
			(
    			type = checkbox
				displayname = "Active Status"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
