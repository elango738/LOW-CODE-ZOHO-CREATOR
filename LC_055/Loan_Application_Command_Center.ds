 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form branch_details
		{
			displayname = "Branch Details"
			success message = "Branch Details Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			branch_id
			(
    			type = text
				displayname = "Branch Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			branch_name
			(
    			type = text
				displayname = "Branch Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			branch_code
			(
    			type = text
				displayname = "Branch Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			branch_manager
			(
    			type = name
				displayname = "Branch Manager"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			branch_address
			(
    			type = address
				displayname = "Branch Address"
     			capture_coordinates = true
     			adjust_using_map = false
